<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>
    <groupId>com.happyprogramming</groupId>
    <artifactId>happyprogramming-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>HappyProgramming Backend</name>
    <description>Programming mentorship platform REST API</description>
    <properties>
        <java.version>17</java.version>
        <maven.compiler.fork>true</maven.compiler.fork>
    </properties>
    <dependencies>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-sqlserver</artifactId></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>happyprogramming-backend</finalName>
        <plugins>
            <!-- One SQL source; preserve already published Flyway versions/checksums. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions><execution>
                    <id>package-canonical-migrations</id>
                    <phase>process-resources</phase>
                    <goals><goal>run</goal></goals>
                    <configuration><target>
                        <mkdir dir="${project.build.outputDirectory}/db/migration"/>
                        <copy file="${project.basedir}/../docs/database/migration/008_20261006_admin_audit_integrity.sql" tofile="${project.build.outputDirectory}/db/migration/V2__admin_audit_integrity.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/001_20261006_add_user_first_last_name.sql" tofile="${project.build.outputDirectory}/db/migration/V3__user_first_last_name.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/004_20261007_mentor_application_approval.sql" tofile="${project.build.outputDirectory}/db/migration/V4__mentor_application_approval.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/002_20261007_add_fresher_profile_level.sql" tofile="${project.build.outputDirectory}/db/migration/V5__add_fresher_profile_level.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/003_20261007_add_my_profile.sql" tofile="${project.build.outputDirectory}/db/migration/V6__add_my_profile.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/010_20261008_add_notifications_table.sql" tofile="${project.build.outputDirectory}/db/migration/V7__add_notifications_table.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/011_20261008_sync_approved_mentors.sql" tofile="${project.build.outputDirectory}/db/migration/V8__sync_approved_mentors.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/012_20261008_publish_approved_mentors.sql" tofile="${project.build.outputDirectory}/db/migration/V9__publish_approved_mentors.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/013_20261008_approval_first_request_lifecycle.sql" tofile="${project.build.outputDirectory}/db/migration/V10__approval_first_request_lifecycle.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/016_20261009_add_service_offering_plan_tier.sql" tofile="${project.build.outputDirectory}/db/migration/V11__add_service_offering_plan_tier.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/018_20261011_fix_mentor_request_utc_deadlines.sql" tofile="${project.build.outputDirectory}/db/migration/V12__fix_mentor_request_utc_deadlines.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/020_20261011_make_mentor_wallet_migration_retriable.sql" tofile="${project.build.outputDirectory}/db/migration/V13__reconcile_mentor_wallet_payouts.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/022_20261012_add_workspace_file_content.sql" tofile="${project.build.outputDirectory}/db/migration/V14__add_workspace_file_content.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/023_20261013_add_mentor_bank_accounts_and_payout_otp.sql" tofile="${project.build.outputDirectory}/db/migration/V15__add_mentor_bank_accounts_and_payout_otp.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/024_20261014_allow_one_off_requests.sql" tofile="${project.build.outputDirectory}/db/migration/V16__allow_one_off_requests.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/025_20261014_seed_one_off_demo_sessions.sql" tofile="${project.build.outputDirectory}/db/migration/V17__seed_one_off_demo_sessions.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/027_20261015_add_availability_slot_indexes.sql" tofile="${project.build.outputDirectory}/db/migration/V18__add_availability_slot_indexes.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/028_20261015_enable_instant_one_off_checkout.sql" tofile="${project.build.outputDirectory}/db/migration/V19__enable_instant_one_off_checkout.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/029_20261016_backfill_one_off_workspace_conversations.sql" tofile="${project.build.outputDirectory}/db/migration/V20__backfill_one_off_workspace_conversations.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/030_20261019_add_mentee_disputes.sql" tofile="${project.build.outputDirectory}/db/migration/V21__add_mentee_disputes.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/031_20261023_add_operational_settings.sql" tofile="${project.build.outputDirectory}/db/migration/V22__add_operational_settings.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/032_20261028_add_payout_approval_step.sql" tofile="${project.build.outputDirectory}/db/migration/V23__add_payout_approval_step.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/033_20261029_add_dispute_refund_approval_step.sql" tofile="${project.build.outputDirectory}/db/migration/V24__add_dispute_refund_approval_step.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/034_20261030_split_dispute_mediation_conversations.sql" tofile="${project.build.outputDirectory}/db/migration/V25__split_dispute_mediation_conversations.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/035_20261030_backfill_open_dispute_mediation_rooms.sql" tofile="${project.build.outputDirectory}/db/migration/V26__backfill_open_dispute_mediation_rooms.sql" overwrite="true"/>
                        <copy file="${project.basedir}/../docs/database/migration/036_20261030_move_legacy_mediation_notices.sql" tofile="${project.build.outputDirectory}/db/migration/V27__move_legacy_mediation_notices.sql" overwrite="true"/>
                    </target></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
